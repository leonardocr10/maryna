{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "web-dev",
      "runtimeExecutable": "cmd",
      "runtimeArgs": [
        "/c",
        "cd web && npx ng serve --port 9093 --host 127.0.0.1 --proxy-config proxy.conf.json"
      ],
      "port": 9093
    },
    {
      "name": "api-dev",
      "runtimeExecutable": "cmd",
      "runtimeArgs": [
        "/c",
        "cd api && npm run dev"
      ],
      "port": 3001
    },
    {
      "name": "ext-fixtures",
      "runtimeExecutable": "python",
      "runtimeArgs": [
        "-m",
        "http.server",
        "9097",
        "--bind",
        "127.0.0.1",
        "--directory",
        "chrome-extension"
      ],
      "port": 9097
    }
  ]
}
