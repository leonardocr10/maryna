PORT=3001
# Banco embutido (SQLite): arquivo dentro da pasta do projeto
DB_FILE=./data/neurolaudos.db
JWT_SECRET=REPLACE_WITH_64_CHAR_RANDOM_VALUE
FILE_ENCRYPTION_KEY=REPLACE_WITH_64_HEX_CHARACTERS
OPENAI_API_KEY=
# Modelo usado: o escolhido em Configurações > IA (padrão gpt-6.1-terra). Esta variável só vale para scripts/validate-suite.mjs.
OPENAI_MODEL=gpt-6.1-terra
# Preços por modelo (US$ por 1M tokens: entrada, entrada em cache, saída), sem mudar o código:
# OPENAI_PRICES={"gpt-6.1-terra":[1.00,0.05,5.00]}
AI_ENABLED=false
ALLOW_EXTERNAL_AI=false
CORS_ORIGIN=http://localhost:9091
# Proxies confiáveis (Caddy e o proxy local do app). Padrão: loopback (só 127.0.0.1/::1). Use 1, true ou false se o arranjo mudar.
# TRUST_PROXY=loopback
PYTHON_BIN=python3
STORAGE_DIR=./storage
ADMIN_EMAIL=admin@local.test
ADMIN_PASSWORD=REPLACE_WITH_STRONG_PASSWORD
# Pré-visualização: texto inserido aparece em vermelho (false desliga). O Word baixado sai sempre em preto.
GENERATED_TEXT_RED=false
# Cotação usada para estimar o custo da IA em reais (atualize quando quiser)
USD_BRL=5.50

# Backup automático criptografado (uma vez por dia, com o sistema aberto); BACKUP_AUTO=false desliga
BACKUP_DIR=./backups
BACKUP_KEEP=14
# Anos de guarda dos laudos aprovados, para a lista de prazo de guarda (confira o mínimo das normas do CFP)
RETENTION_YEARS=5

# Leitura em voz ("Ouvir"): local = voz Piper no computador (padrao, nada sai da maquina);
# edge = voz natural online da Microsoft (o texto da secao e enviado a Microsoft; exige autorizacao da psicologa).
TTS_PROVIDER=local
# EDGE_TTS_VOICE=pt-BR-FranciscaNeural
# EDGE_TTS_RATE=-5%

# Ditado por voz (microfone nos campos de texto): o áudio vai do navegador direto para a OpenAI (WebRTC) com uma
# credencial temporária criada pelo servidor; a chave OPENAI_API_KEY nunca vai para o navegador. Nada do áudio ou do
# texto ditado é gravado ou registrado no servidor. Exige AI_ENABLED=true, ALLOW_EXTERNAL_AI=true e autorização da psicóloga.
DICTATION_ENABLED=false
# Modelo de transcrição em tempo real (verificado na conta da API ao abrir cada sessão)
DICTATION_MODEL=gpt-live-transcribe
# Atraso de transcrição: minimal | low | medium | high | xhigh (mais atraso = mais precisão)
DICTATION_DELAY=low
# Controle de custo: duração máxima de cada sessão (segundos) e sessões por pessoa por dia
DICTATION_MAX_SECONDS=900
DICTATION_DAILY_LIMIT=80
# Termos extras para o reconhecimento (separados por vírgula; sem dados de pacientes)
# DICTATION_KEYWORDS=Neupsilin, TDE-II

# ChatGPT para a anamnese (alternativa à API; nenhuma chamada paga à API é feita nesse fluxo).
# Cópia e colagem assistida: sempre disponível nas avaliações "Com IA". Tarefas expiram em CHATGPT_TASK_HOURS;
# rascunhos não confirmados são apagados CHATGPT_KEEP_DAYS depois da expiração.
CHATGPT_TASK_HOURS=24
CHATGPT_KEEP_DAYS=7
# Plugin MCP no ChatGPT (leitura e gravação com OAuth): DESLIGADO por padrão. Ligar só com autorização da psicóloga
# responsável e revisão de segurança: exige endereço HTTPS público (túnel ou proxy) apontando para a porta do site (9091).
CHATGPT_MCP_ENABLED=false
# PUBLIC_BASE_URL=https://neurolaudos.seudominio.com.br
# Hosts aceitos como retorno do OAuth (padrão: chatgpt.com)
# CHATGPT_OAUTH_REDIRECT_HOSTS=chatgpt.com
