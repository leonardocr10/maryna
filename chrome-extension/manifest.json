{
  "manifest_version": 3,
  "name": "NeuroLaudos IA — Modo automático",
  "short_name": "NeuroLaudos Auto",
  "version": "1.0.0",
  "description": "Gera rascunhos das seções com o ChatGPT e o plugin NeuroLaudos IA, de forma supervisionada. Nunca aprova textos nem autoriza por você.",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "assets/icons/icon16.png",
    "32": "assets/icons/icon32.png",
    "48": "assets/icons/icon48.png",
    "128": "assets/icons/icon128.png"
  },
  "action": {
    "default_title": "NeuroLaudos IA — Modo automático",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "assets/icons/icon16.png",
      "32": "assets/icons/icon32.png"
    }
  },
  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },
  "permissions": [
    "storage",
    "scripting",
    "alarms",
    "notifications"
  ],
  "host_permissions": [
    "http://localhost:9091/*",
    "http://127.0.0.1:9091/*",
    "https://chatgpt.com/*"
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://*/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "http://localhost:9091/*",
        "http://127.0.0.1:9091/*"
      ],
      "js": [
        "content/selectors.js",
        "content/dom-observer.js",
        "content/neurolaudos.js"
      ],
      "css": [
        "content/neurolaudos.css"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://chatgpt.com/*"
      ],
      "js": [
        "content/selectors.js",
        "content/dom-observer.js",
        "content/chatgpt.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "ui/panel.html",
        "ui/panel.css",
        "ui/panel.js",
        "ui/theme.js"
      ],
      "matches": [
        "http://localhost:9091/*",
        "http://127.0.0.1:9091/*",
        "https://*/*"
      ]
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}
